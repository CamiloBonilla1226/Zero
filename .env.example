# Copia este archivo a .env.local y reemplaza los valores con los de tu proyecto de Supabase.
# La URL y la anon key son públicas por diseño: la seguridad real la aplican las políticas de RLS.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Clave pública VAPID para las notificaciones push del panel (es pública por diseño; la
# privada vive solo en los secretos de la Edge Function notificar-pedido-nuevo).
VITE_VAPID_PUBLIC_KEY=tu-clave-publica-vapid
